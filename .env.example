# =============================================================================
# LICITACIONES MERCADO PÚBLICO — Variables de entorno
# =============================================================================
# Copia este archivo como .env en la raíz del proyecto y rellena los valores.
# NUNCA subas .env a control de versiones (está en .gitignore).
# Todas las variables usan el prefijo LICIT_
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETOS — APIs externas
# -----------------------------------------------------------------------------

# API Key del SIF de CMF Chile (necesaria para obtener el valor UTM en tiempo real)
# Registro gratuito en: https://api.cmfchile.cl/
# Si no se configura, Etapa 4 usa el valor estático LICIT_ETAPA4_VALOR_UTM como fallback
LICIT_CMF_API_KEY=

# Ticket/API Key de Mercado Público (necesaria para consultar detalles en Etapa 3)
# Solicitar en: https://api.mercadopublico.cl/
# Si no se configura, las consultas se realizan sin autenticación (límite de tasa menor)
LICIT_MERCADO_PUBLICO_TICKET=

# URL del proveedor de tipo de cambio USD→CLP
# Por defecto usa api.exchangerate.host (gratuito, sin key)
LICIT_FX_PROVIDER_URL=https://api.exchangerate.host/latest

# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------

# Entorno de ejecución: production | development
LICIT_ENV=production

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LICIT_LOG_LEVEL=INFO

# Activar modo test: limita registros a LICIT_TEST_LIMIT — útil para desarrollo
LICIT_TEST_MODE=false
LICIT_TEST_LIMIT=100

# -----------------------------------------------------------------------------
# PARÁMETROS OPERACIONALES (opcionales — los valores por defecto son seguros)
# Descomenta y ajusta solo si necesitas cambiar el comportamiento por defecto
# -----------------------------------------------------------------------------

# Etapa 1 — Auditoría de taxonomía
# LICIT_ETAPA1_UMBRAL_ALERTA=3          # Mínimo de ocurrencias para reportar un valor nuevo
# LICIT_ETAPA1_SIMILITUD_THRESHOLD=0.85  # Umbral similitud fuzzy (0.0–1.0)

# Etapa 3 — Enriquecimiento API
# LICIT_ETAPA3_DELAY_SEGUNDOS=1.5        # Delay entre llamadas (respetar rate limit)
# LICIT_ETAPA3_MAX_REINTENTOS=3          # Reintentos por registro fallido
# LICIT_ETAPA3_TIMEOUT=40               # Timeout por petición HTTP en segundos

# Etapa 4 — Reporte ejecutivo
# LICIT_ETAPA4_VALOR_UTM=65000           # Valor UTM en CLP (fallback si CMF API no responde)
# LICIT_ETAPA4_DIAS_GRACIA_HISTORICO=30  # Días de gracia para licitaciones vencidas recientes
